      </layout></widget>
     </widget></item>
     <item><widget class="QComboBox" name="snoozeDuration">
      <item><property name="text"><string>稍后 5 分钟再提醒</string></property></item><item><property name="text"><string>稍后 10 分钟再提醒</string></property></item><item><property name="text"><string>稍后 15 分钟再提醒</string></property></item>
     </widget></item>
