       <item><widget class="QLabel" name="titleLabel"><property name="text"><string>给自己一个小小的休息</string></property><property name="wordWrap"><bool>true</bool></property><property name="textFormat"><enum>Qt::PlainText</enum></property></widget></item>
       <item><widget class="QTextEdit" name="bodyLabel"><property name="readOnly"><bool>true</bool></property><property name="frameShape"><enum>QFrame::NoFrame</enum></property><property name="minimumSize"><size><width>0</width><height>60</height></size></property><property name="maximumSize"><size><width>16777215</width><height>90</height></size></property></widget></item>
