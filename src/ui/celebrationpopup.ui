      <property name="leftMargin"><number>0</number></property><property name="rightMargin"><number>0</number></property><property name="topMargin"><number>0</number></property><property name="bottomMargin"><number>0</number></property><property name="spacing"><number>10</number></property>
      <item><widget class="QPushButton" name="completeButton"><property name="text"><string>完成提醒</string></property></widget></item>
      <item><widget class="QPushButton" name="snoozeButton"><property name="text"><string>稍后提醒</string></property></widget></item>
      <item><widget class="QPushButton" name="dismissButton"><property name="text"><string>忽略</string></property></widget></item>
     </layout></widget></item>
